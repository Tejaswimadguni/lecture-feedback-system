# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Dataset & Raw Inputs
# (Keep tracked sample lecture files and student feedback dataset)
data/raw/audio/*
!data/raw/audio/6100l-lecture-1-version-2_360p_16_9.mp3
data/raw/video/*
!data/raw/video/6100l-lecture-1-version-2_360p_16_9.mp4
!data/raw/students/
!data/raw/students/*.csv

# Processed & Intermediate Artifacts
data/processed/*
!data/processed/**/.gitkeep
whisper_chunks_*/

# Vector Store & Search Indices (generated at runtime)
data/vector_store/*
!data/vector_store/**/.gitkeep
*.faiss

# Evaluation & Scorer Results (generated at runtime)
data/results/*
!data/results/**/.gitkeep

# Model weights & cache files
*.pt
*.pth
*.bin
*.onnx
.cache/
models/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Frontend / Web dependencies and builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.npm/

